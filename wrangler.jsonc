{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-study",
  "main": "./src/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-study-db",
      "database_id": "89914e1e-bf4a-4dc7-9764-c0ae66276fe3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "my-project-bucket"
    }
  ]
}
