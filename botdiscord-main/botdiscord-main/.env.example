# Cấu hình Discord Bot
# Bạn có thể điền thông tin vào đây hoặc trong config.json -> mục "DISCORD"

# Token lấy từ Discord Developer Portal (https://discord.com/developers/applications) -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Application ID / Client ID lấy từ General Information
DISCORD_CLIENT_ID=your_client_id_here

# Tiền tố lệnh prefix (mặc định là !)
DISCORD_PREFIX=!

# ID người dùng Discord có quyền Admin cao nhất (Super Admin)
DISCORD_ADMIN_ID=your_discord_user_id

# Groq API Key cho tính năng Bot AI Chat (Lấy miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
