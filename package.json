{
  "name": "3tg-study",
  "version": "9.9.9",
  "description": "3TG — Web và App học tập thông minh phong cách Duolingo cùng Mascot Thỏ Bảy Màu",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "wrangler dev",
    "dev:web": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:icon": "python scripts/convert_icon.py",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder --win",
    "electron:build": "npm run build:icon && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "wrangler": "^4.0.0"
  },
  "build": {
    "appId": "com.tonepink.3tgstudy",
    "productName": "3TG Học Vui Mỗi Ngày",
    "copyright": "Copyright © 2026 3TG Study",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "build/local_replica.sqlite",
      "build/icon.ico",
      "package.json",
      "src/**/*"
    ],
    "files": [
      "public/**/*",
      "src/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json",
      "wrangler.jsonc",
      ".dev.vars"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3TG Học Vui Mỗi Ngày",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
